{
  "name": "holo-image-styles",
  "version": "1.0.0",
  "private": true,
  "description": "Holographic card effects for the WordPress Image block. Free and All Effects editions are built from this single repository.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "wp-scripts build --experimental-modules",
    "start": "wp-scripts start --experimental-modules",
    "build:free": "node bin/build.mjs free",
    "build:all": "node bin/build.mjs all",
    "build:dist": "npm run build && node bin/build.mjs free && node bin/build.mjs all",
    "check-variants": "node bin/check-variants.mjs",
    "lint:js": "wp-scripts lint-js src",
    "lint:css": "wp-scripts lint-style 'src/css/**/*.css'",
    "test:e2e": "wp-scripts test-playwright",
    "wp-env": "wp-env"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@wordpress/block-editor": "^17.1.0",
    "@wordpress/components": "^40.1.0",
    "@wordpress/compose": "^8.8.0",
    "@wordpress/e2e-test-utils-playwright": "^2.0.0",
    "@wordpress/element": "^8.7.0",
    "@wordpress/env": "^11.15.0",
    "@wordpress/hooks": "^4.55.0",
    "@wordpress/i18n": "^6.28.0",
    "@wordpress/scripts": "^35.0.0",
    "archiver": "^7.0.1"
  },
  "dependencies": {
    "@wordpress/interactivity": "^6.55.0"
  }
}
